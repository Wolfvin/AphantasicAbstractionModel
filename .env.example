# RSVS Configuration
# Copy this file to .env and adjust values

# Backend — host and port for the Python bridge HTTP server
RSVS_HOST=0.0.0.0
RSVS_PORT=8000

# Backend — root data directory for artifacts and state
RSVS_DATA_DIR=./data

# Backend — logging level (debug, info, warning, error)
RSVS_LOG_LEVEL=info

# Frontend — base URL for the backend API (used by Next.js client-side)
NEXT_PUBLIC_RSVS_BACKEND_URL=http://localhost:8000

# Frontend — WebSocket URL for real-time updates
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Rust Core — output directory for generated atom artifacts
RSVS_ATOM_OUTPUT_DIR=./data/atom
