# RSVS Configuration
# Copy this file to .env and adjust values

# --- Server ---
RSVS_HOST=0.0.0.0
RSVS_PORT=8000
RSVS_DATA_DIR=./data
RSVS_LOG_LEVEL=info

# --- Frontend ---
NEXT_PUBLIC_RSVS_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# --- Atom / Persistence ---
RSVS_ATOM_OUTPUT_DIR=./data/atom

# --- Security (IMPORTANT for production) ---
# Set RSVS_API_KEY to a strong random value to enable API key authentication.
# If empty or not set, authentication is skipped (development mode only).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RSVS_API_KEY=

# CORS allowed origins (comma-separated).
# NEVER use * in production. Example: http://localhost:3000,https://rsvs.example.com
RSVS_ALLOWED_ORIGINS=http://localhost:3000
