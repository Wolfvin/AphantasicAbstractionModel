# RSVS Configuration
# Copy this file to .env and adjust values
# v8.3: Added RSVS_SESSION_SECRET, unified env vars

# --- Server ---
RSVS_HOST=127.0.0.1
RSVS_PORT=8000
# BridgeConfig also reads these (for Python BridgeConfig compatibility)
RSVS_BRIDGE_HOST=127.0.0.1
RSVS_BRIDGE_PORT=8000
RSVS_DATA_DIR=./data
RSVS_LOG_LEVEL=info

# --- Frontend ---
NEXT_PUBLIC_RSVS_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# --- Atom / Persistence ---
RSVS_ATOM_OUTPUT_DIR=./data/atom

# --- Security (CRITICAL for production) ---
# RSVS_API_KEY: Required in production. If empty or not set,
# authentication is skipped (development mode only).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RSVS_API_KEY=

# RSVS_SESSION_SECRET: Required in production. Used to HMAC-sign session
# cookies. If not set, falls back to RSVS_API_KEY, then to an ephemeral
# random secret (which breaks sessions on restart and doesn't work in
# multi-instance deployments).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
RSVS_SESSION_SECRET=

# CORS allowed origins (comma-separated).
# NEVER use * in production. Example: http://localhost:3000,https://rsvs.example.com
RSVS_ALLOWED_ORIGINS=http://localhost:3000
