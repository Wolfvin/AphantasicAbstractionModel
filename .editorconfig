# ──────────────────────────────────────────────────────────────────────
#  SymbolicPuzzle3D — EditorConfig
#  https://editorconfig.org
# ──────────────────────────────────────────────────────────────────────

root = true

# ── Defaults ─────────────────────────────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# ── Rust ─────────────────────────────────────────────────────────────
[*.rs]
indent_size = 4

[Cargo.toml]
indent_size = 4

[Cargo.lock]
indent_size = 4

# ── Python ───────────────────────────────────────────────────────────
[*.py]
indent_size = 4

[pyproject.toml]
indent_size = 4

# ── TypeScript / JavaScript / JSX / TSX ──────────────────────────────
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2

# ── JSON / YAML ─────────────────────────────────────────────────────
[*.{json,yaml,yml}]
indent_size = 2

# ── Markdown ─────────────────────────────────────────────────────────
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# ── Shell scripts ────────────────────────────────────────────────────
[*.sh]
indent_size = 2

# ── Makefile (tabs required) ────────────────────────────────────────
[Makefile]
indent_style = tab

# ── Docker ───────────────────────────────────────────────────────────
[Dockerfile*]
indent_size = 2

[docker-compose*.yml]
indent_size = 2

# ── Web ──────────────────────────────────────────────────────────────
[*.{css,scss,html}]
indent_size = 2
