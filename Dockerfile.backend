# ──────────────────────────────────────────────────────────────────────
#  SymbolicPuzzle3D — Backend-only Dockerfile for Koyeb deployment
#  Stage 1: Build Rust core with maturin
#  Stage 2: Lean Python runtime (port 8000 only)
# ──────────────────────────────────────────────────────────────────────

# =====================================================================
#  Stage 1 — Build Rust core + Python wheel
# =====================================================================
FROM rust:1.82-bookworm AS rust-builder

ENV PYO3_USE_ABI3_FORWARD_COMPATIBILITY=1
ENV CARGO_TERM_COLOR=always

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir maturin

WORKDIR /build

# Cache Cargo dependencies
COPY backend/Cargo.toml backend/Cargo.lock ./
COPY backend/crates/rsvs-core/Cargo.toml ./crates/rsvs-core/Cargo.toml
RUN mkdir -p crates/rsvs-core/src && echo "" > crates/rsvs-core/src/lib.rs
RUN cargo build --release 2>/dev/null || true

# Full build with real source
COPY backend/ .
RUN cargo build --release
RUN maturin build --release --strip --out /dist/wheels

# =====================================================================
#  Stage 2 — Lean Python runtime
# =====================================================================
FROM python:3.12-slim-bookworm

# Install curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd --gid 1000 appuser \
    && useradd --uid 1000 --gid appuser --shell /bin/bash --create-home appuser

WORKDIR /app

# Install Python wheel from Stage 1 + FastAPI deps
COPY --from=rust-builder /dist/wheels/*.whl /tmp/wheels/
RUN pip install --no-cache-dir /tmp/wheels/*.whl "fastapi[standard]" uvicorn slowapi \
    && rm -rf /tmp/wheels

# Copy Python bridge source
COPY --chown=appuser:appuser backend/python/ /app/backend/python/

# Shared data volume for atom artifacts
RUN mkdir -p /app/data && chown appuser:appuser /app/data

# Environment
ENV PYTHONPATH=/app/backend/python
ENV PYTHONUNBUFFERED=1
ENV RSVS_ATOM_DIR=/app/data
ENV PORT=8000

EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

USER appuser

CMD ["python3", "-m", "rsvs.fastapi_server"]
