# RSVS Backend Configuration (v8.3)
# Copy this file to .env and adjust values as needed.

# --- Persistence ---
RSVS_ATOM_OUTPUT_DIR=./data/atom

# --- Server ---
# FastAPI reads RSVS_HOST/RSVS_PORT for uvicorn bind
RSVS_HOST=0.0.0.0
RSVS_PORT=8000
# BridgeConfig also reads RSVS_BRIDGE_HOST/RSVS_BRIDGE_PORT
RSVS_BRIDGE_HOST=127.0.0.1
RSVS_BRIDGE_PORT=8000
RSVS_DEV_RELOAD=0

# --- Security (CRITICAL for production) ---
# RSVS_API_KEY: Required in production. If empty, auth is skipped
# (development mode only — the server will warn on startup).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RSVS_API_KEY=

# RSVS_SESSION_SECRET: Required in production. Used to sign session cookies.
# If not set, falls back to RSVS_API_KEY, then ephemeral random.
# Ephemeral secrets break sessions on restart and don't work multi-instance.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
RSVS_SESSION_SECRET=

# CORS allowed origins (comma-separated).
# NEVER use * in production.
RSVS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend (set in frontend/.env.local) ---
# NEXT_PUBLIC_RSVS_BACKEND_URL=http://localhost:8000
# NEXT_PUBLIC_RSVS_API_KEY=
