# RSVS Backend Configuration
# Copy this file to .env and adjust values as needed.

# --- Persistence ---
RSVS_ATOM_OUTPUT_DIR=./data/atom

# --- Server ---
RSVS_BRIDGE_HOST=127.0.0.1
RSVS_BRIDGE_PORT=8000

# --- Security ---
# See root .env.example for RSVS_API_KEY and RSVS_ALLOWED_ORIGINS
RSVS_API_KEY=
RSVS_ALLOWED_ORIGINS=http://localhost:3000
