# RSVS Backend Configuration
# Copy this file to .env and adjust values as needed.

# Directory where the backend writes atom artifacts (snapshots, events, reports).
# Relative paths are resolved from the backend root directory.
RSVS_ATOM_OUTPUT_DIR=./data/atom

# Host address the bridge HTTP server binds to.
# Use "0.0.0.0" to listen on all interfaces, "127.0.0.1" for local only.
RSVS_BRIDGE_HOST=127.0.0.1

# Port the bridge HTTP server listens on.
RSVS_BRIDGE_PORT=8000
