# RSVS Backend Configuration (v6.1)
# Copy this file to .env and adjust values as needed.

# --- Persistence ---
RSVS_ATOM_OUTPUT_DIR=./data/atom

# --- Server ---
RSVS_BRIDGE_HOST=127.0.0.1
RSVS_BRIDGE_PORT=8000
RSVS_HOST=0.0.0.0
RSVS_PORT=8000
RSVS_DEV_RELOAD=0

# --- Security ---
# Set RSVS_API_KEY to a strong random value in production.
# If empty, auth is skipped (development mode only).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RSVS_API_KEY=
# Comma-separated list of allowed CORS origins.
# NEVER use * in production.
RSVS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend (set in frontend/.env.local) ---
# NEXT_PUBLIC_RSVS_BACKEND_URL=http://localhost:8000
# NEXT_PUBLIC_RSVS_API_KEY=
