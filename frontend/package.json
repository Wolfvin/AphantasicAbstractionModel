{
  "name": "@rsvs/frontend",
  "version": "6.0.0",
  "private": true,
  "description": "RSVS 3D Knowledge Graph Visualization",
  "keywords": [
    "rsvs",
    "knowledge-graph",
    "3d-visualization",
    "symbolic-ai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Wolfvin/SymbolicPuzzle3D.git",
    "directory": "frontend"
  },
  "bugs": {
    "url": "https://github.com/Wolfvin/SymbolicPuzzle3D/issues"
  },
  "homepage": "https://github.com/Wolfvin/SymbolicPuzzle3D#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.11",
